<%- include('partials/header') %>

<div class="auth-wrapper" style="max-width: 500px;">
  <div class="auth-card" style="text-align: center;">
    <div style="font-size: 3rem; margin-bottom: 0.5rem;">⚠️</div>
    <h1 style="font-size: 1.5rem; margin-bottom: 0.5rem;"><%= typeof title !== 'undefined' ? title : 'An Error Occurred' %></h1>
    <p style="color: var(--text-muted); margin-bottom: 1.5rem;">
      <%= typeof message !== 'undefined' ? message : 'Something went wrong while processing your request.' %>
    </p>

    <div style="display: flex; gap: 0.75rem; justify-content: center;">
      <a href="/dashboard" class="btn btn-primary">Go to Dashboard</a>
      <a href="javascript:history.back()" class="btn btn-secondary">Go Back</a>
    </div>
  </div>
</div>

<%- include('partials/footer') %>
