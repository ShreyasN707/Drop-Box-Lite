<%- include('partials/header') %>

<%- include('partials/alert') %>

<div class="card">
  <div class="quota-header">
    <strong>Storage Usage</strong>
    <span><strong><%= quotaUsedFormatted %></strong> of <strong><%= quotaTotalFormatted %></strong> used (<%= quotaPercentage %>%)</span>
  </div>
  <div class="quota-bar-container">
    <div class="quota-bar-fill <%= quotaPercentage > 90 ? 'danger' : (quotaPercentage > 75 ? 'warning' : '') %>" style="width: <%= quotaPercentage %>%;"></div>
  </div>
  <div class="quota-footer">
    <span>Free Tier Quota</span>
    <span><%= formatBytes(Math.max(0, user.storageQuota - user.storageUsed)) %> available</span>
  </div>
</div>

<div class="upload-card">
  <form action="/files/upload" method="POST" enctype="multipart/form-data" class="upload-form">
    <div>
      <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="#2563eb" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="margin-bottom: 0.5rem;">
        <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
        <polyline points="17 8 12 3 7 8"></polyline>
        <line x1="12" y1="3" x2="12" y2="15"></line>
      </svg>
      <h3 style="font-size: 1.1rem; margin-bottom: 0.25rem;">Upload new file</h3>
      <p class="upload-hint">Upload documents, images, archives or media up to <%= maxFileSizeMb %> MB</p>
    </div>

    <div style="display: flex; gap: 0.75rem; align-items: center; flex-wrap: wrap; justify-content: center;">
      <input type="file" name="file" required class="form-input" style="max-width: 300px; padding: 0.45rem;">
      <button type="submit" class="btn btn-primary">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <polyline points="16 16 12 12 8 16"></polyline>
          <line x1="12" y1="12" x2="12" y2="21"></line>
          <path d="M20.39 18.39A5 5 0 0 0 18 9h-1.26A8 8 0 1 0 3 16.3"></path>
          <polyline points="16 16 12 12 8 16"></polyline>
        </svg>
        Upload File
      </button>
    </div>
  </form>
</div>

<div class="card" style="padding: 0; overflow: hidden;">
  <div style="padding: 1.25rem 1.5rem; border-bottom: 1px solid var(--border-color); display: flex; justify-content: space-between; align-items: center;">
    <div>
      <h2 class="card-title" style="margin: 0;">My Files</h2>
      <p class="card-subtitle" style="margin: 0; margin-top: 0.2rem;"><%= myFiles.length %> <%= myFiles.length === 1 ? 'file' : 'files' %> uploaded</p>
    </div>
  </div>

  <% if (myFiles.length === 0) { %>
    <div class="empty-state">
      <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
        <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
        <polyline points="14 2 14 8 20 8"></polyline>
        <line x1="12" y1="18" x2="12" y2="12"></line>
        <line x1="9" y1="15" x2="15" y2="15"></line>
      </svg>
      <h3>No files uploaded yet</h3>
      <p>Use the upload box above to add your first file to your cloud storage.</p>
    </div>
  <% } else { %>
    <div class="table-responsive">
      <table class="file-table">
        <thead>
          <tr>
            <th>Name</th>
            <th>Visibility</th>
            <th>Downloads</th>
            <th>Last Downloaded</th>
            <th>Uploaded</th>
            <th style="text-align: right;">Actions</th>
          </tr>
        </thead>
        <tbody>
          <% myFiles.forEach(function(file) { %>
            <% const fType = getFileType(file.mimetype); %>
            <tr>
              <td>
                <div class="file-name-cell">
                  <div class="file-icon icon-<%= fType %>">
                    <%= fType.substring(0, 3).toUpperCase() %>
                  </div>
                  <div class="file-info">
                    <span class="file-name"><%= file.originalName %></span>
                    <span class="file-meta"><%= formatBytes(file.size) %> &bull; <%= file.mimetype %></span>
                  </div>
                </div>
              </td>
              <td>
                <% if (file.isPublic) { %>
                  <span class="badge badge-public">🌐 Public</span>
                <% } else { %>
                  <span class="badge badge-private">🔒 Private</span>
                <% } %>
                <% if (file.sharedWith && file.sharedWith.length > 0) { %>
                  <span class="badge badge-active" title="Shared with <%= file.sharedWith.length %> users">👥 <%= file.sharedWith.length %></span>
                <% } %>
                <% if (file.shareLinks && file.shareLinks.length > 0) { %>
                  <span class="badge badge-active" title="<%= file.shareLinks.length %> expiring links created">🔗 <%= file.shareLinks.length %></span>
                <% } %>
              </td>
              <td>
                <strong><%= file.downloadCount %></strong> <%= file.downloadCount === 1 ? 'time' : 'times' %>
              </td>
              <td style="color: var(--text-muted); font-size: 0.85rem;">
                <%= formatDate(file.lastDownloadedAt) %>
              </td>
              <td style="color: var(--text-muted); font-size: 0.85rem;">
                <%= formatDate(file.createdAt) %>
              </td>
              <td>
                <div class="actions-cell" style="justify-content: flex-end;">
                  <a href="/files/<%= file._id %>/download" class="btn btn-secondary btn-sm" title="Download directly">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                      <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
                      <polyline points="7 10 12 15 17 10"></polyline>
                      <line x1="12" y1="15" x2="12" y2="3"></line>
                    </svg>
                    Download
                  </a>

                  <a href="/files/<%= file._id %>" class="btn btn-secondary btn-sm" title="Manage sharing & permissions">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                      <circle cx="18" cy="5" r="3"></circle>
                      <circle cx="6" cy="12" r="3"></circle>
                      <circle cx="18" cy="19" r="3"></circle>
                      <line x1="8.59" y1="13.51" x2="15.42" y2="17.49"></line>
                      <line x1="15.41" y1="6.51" x2="8.59" y2="10.49"></line>
                    </svg>
                    Share
                  </a>

                  <form action="/files/<%= file._id %>/delete" method="POST" onsubmit="return confirm('Are you sure you want to permanently delete this file? This will free up <%= formatBytes(file.size) %> of your storage.');" style="display: inline;">
                    <button type="submit" class="btn btn-danger btn-sm" title="Delete file">
                      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <polyline points="3 6 5 6 21 6"></polyline>
                        <path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path>
                      </svg>
                    </button>
                  </form>
                </div>
              </td>
            </tr>
          <% }); %>
        </tbody>
      </table>
    </div>
  <% } %>
</div>

<% if (sharedFiles && sharedFiles.length > 0) { %>
  <div class="card" style="padding: 0; overflow: hidden;">
    <div style="padding: 1.25rem 1.5rem; border-bottom: 1px solid var(--border-color);">
      <h2 class="card-title" style="margin: 0;">Shared With Me</h2>
      <p class="card-subtitle" style="margin: 0; margin-top: 0.2rem;">Files that other users have granted you access to</p>
    </div>

    <div class="table-responsive">
      <table class="file-table">
        <thead>
          <tr>
            <th>Name</th>
            <th>Shared By</th>
            <th>Size</th>
            <th>Last Downloaded</th>
            <th style="text-align: right;">Action</th>
          </tr>
        </thead>
        <tbody>
          <% sharedFiles.forEach(function(file) { %>
            <% const fType = getFileType(file.mimetype); %>
            <tr>
              <td>
                <div class="file-name-cell">
                  <div class="file-icon icon-<%= fType %>">
                    <%= fType.substring(0, 3).toUpperCase() %>
                  </div>
                  <div class="file-info">
                    <span class="file-name"><%= file.originalName %></span>
                    <span class="file-meta"><%= file.mimetype %></span>
                  </div>
                </div>
              </td>
              <td>
                <strong><%= file.owner ? file.owner.name : 'Unknown' %></strong>
                <div style="font-size: 0.75rem; color: var(--text-muted);"><%= file.owner ? file.owner.email : '' %></div>
              </td>
              <td><%= formatBytes(file.size) %></td>
              <td style="color: var(--text-muted); font-size: 0.85rem;"><%= formatDate(file.lastDownloadedAt) %></td>
              <td style="text-align: right;">
                <a href="/files/<%= file._id %>/download" class="btn btn-primary btn-sm">
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
                    <polyline points="7 10 12 15 17 10"></polyline>
                    <line x1="12" y1="15" x2="12" y2="3"></line>
                  </svg>
                  Download
                </a>
              </td>
            </tr>
          <% }); %>
        </tbody>
      </table>
    </div>
  </div>
<% } %>

<%- include('partials/footer') %>
